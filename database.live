# Live PostgreSQL schema snapshot from 2026-09-01 with the pending location migration documented below.
# The following tables exist in the public schema:
# AboutContent, ActivityLog, AdClick, AdImpression, AdRate, Advertisement,
# Agency, Bank, BankRate, BlogPost, Collection, CollectionProperty, Comment,
# FeaturedInformation, JobApplication, JobListing, KYC, Like, Media,
# Notification, Property, PropertyDetailsApartment, PropertyDetailsHouse,
# PropertyDetailsLand, PropertyDetailsSpace, PropertyFeatures, PropertyLocation, PropertyMedia,
# PropertyNature, PropertyOpenHouse, PropertySaleStatus, Requirement, Review, Role,
# RolePermission, SearchTerm, Subscriber, SupportArticle, SystemSettings,
# Visitor, _PropertyToPropertyNature, _prisma_migrations, accounts,
# agency_config, listing_stats_cache, permissions,
# property_drafts, role_permission_map, sessions, users, verification_tokens.

Table: property_details_land, Model: PropertyDetailsLand
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, unique, references Property.id;
> landArea: numeric(18,10), stored in square meters;
> dimension: varchar(48);
> plotNumber: text;
> moreDetails: jsonb;

Table: property_details_house, Model: PropertyDetailsHouse
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, unique, references Property.id;
> builtUpArea: numeric(18,10), stored in square meters;
> bedrooms: smallint;
> bathrooms: smallint;
> kitchens: smallint;
> livingRooms: smallint;
> diningRooms: smallint;
> totalRooms: smallint;
> totalFloors: numeric(18,10);
> yearBuilt: timestamp;
> furnishing: enum HouseFurnishing (unfurnsihed, semifurnished, furnished);
> parking: smallint;
> moreDetails: jsonb;

Table: property_details_apartment, Model: PropertyDetailsApartment
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, unique, references Property.id;
> builtUpArea: numeric(18,10), stored in square meters;
> bedrooms: smallint;
> bathrooms: smallint;
> kitchens: smallint;
> livingRooms: smallint;
> diningRooms: smallint;
> floorNumber: smallint;
> furnishing: enum ApartmentFurnishing (fullFurnished, semiFurnished, unfurnished);
> hasBalcony: boolean;
> parking: smallint;
> yearBuilt: timestamp;
> moreDetails: jsonb;

Table: property_details_space, Model: PropertyDetailsSpace
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, unique, references Property.id;
> spaceType: varchar;
> totalArea: numeric(18,10), stored in square meters;
> onFloor: smallint;
> furnishing: enum SpaceFurnishing (fullFurnished, semiFurnished, unfurnished);
> bathrooms: smallint;
> parking: smallint;
> moreDetails: jsonb;

Table: Property, Model: Property
Fields:
> id: int, primary key, auto incremental;
> propertyId: text, optional;
> status: text, default pending;
> isFeatured: boolean, default false;
> isExclusive: boolean, default false;
> isVerified: boolean, default false;
> remarks: text, optional;
> roadType: enum RoadType, optional; values: blacktopped, concrete, paved_block, gravel_murrum, earth_dirt, stone_paved, brick_paved, unknown;
> roadSize: numeric(18,10), optional, stored in meters;
> listedById: int, references users.id;
> title: text;
> slug: text, optional;
> created_on: timestamp, default current_timestamp;
> updated_at: timestamp;
> views: int, default 0;
> shares: int, default 0;
> locationData: jsonb, optional;
> purposes: PropertyPurpose[], enum array, default empty;
> types: PropertyType[], enum array, default empty;
> price_basis: enum PropertyPriceBasis, default total;
> price_listed: numeric(18,2), optional;
> price_negotiable: boolean, default false;

Table: location, Model: Location
Fields:
> id: int, primary key, auto incremental;
> name: text;
> type: text;
> parent_id: int, optional, references location.id, on delete set null;
> details: jsonb, optional;
> unique: (name, type, parent_id);

Table: PropertyMedia, Model: PropertyMedia
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, references Property.id, cascade delete;
> type: text;
> resourceUrl: text;
> index: int;

Table: PropertySaleStatus, Model: PropertySaleStatus
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, references Property.id, cascade delete;
> status: text;
> updatedOn: timestamp, default current_timestamp, auto-updated;

Table: property_ammenities, Model: PropertyAmmenity
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, references Property.id, cascade delete;
> ammenity_id: int, references master_ammenities.id;
> status: varchar(24);
> updatedAt: timestamp, default current_timestamp, auto-updated;

Table: master_ammenities, Model: MasterAmmenity
Fields:
> id: int, primary key, auto incremental;
> name: string;
> status: string;

Table: Media, Model: Media
Fields:
> id: int, primary key, auto incremental;
> uploaderId: int, references users.id;
> path: text;
> upload_for: text;
> original_name: text;
> uploaded_at: timestamp, default current_timestamp;

Table: PropertyFeatures, Model: PropertyFeatures
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, references Property.id;
> bedrooms: int, optional;
> bathrooms: int, optional;
> kitchens: int, optional;
> livingRooms: int, optional;
> floorNumber: int, optional;
> totalFloors: int, optional;
> furnishing: text, optional;
> builtUpArea: numeric(18,10), optional, stored in square meters;
> parkingAvailable: boolean, optional;
> elevator: boolean, optional;
> security: boolean, optional;
> waterSupply: boolean, optional;
> electricity: boolean, optional;

Table: PropertyLocation, Model: PropertyLocation
Fields:
> id: int, primary key, auto incremental;
> propertyId: int, references Property.id;
> latitude: double precision, optional;
> longitude: double precision, optional;
> country: text, default Nepal;
> province: text;
> district: text;
> cityVillage: text;
> area: text, optional;
> ward: text, optional;
> landmark: text, optional;
> distanceFrom: text, optional;

Enum: PropertyPriceBasis
Values: total, perUnit, perMonth, perYear, perUnitPerMonth, perUnitPerYear

Note: Property.media JSON is not present on the live server. Property media is stored in PropertyMedia. Property.soldStatus was replaced by PropertySaleStatus. The table inventory above was confirmed from information_schema.columns.
