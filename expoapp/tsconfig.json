{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@@/*": [
        "./src/*"
      ],
      "#/*": [
        "./.neup/*"
      ],
      "$/*": [
        "./base/*"
      ],
      "@android": [
        "./android/*"
      ],
      "@ios": [
        "./ios/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, ".neup/components/ui/text.tsx"  ]
}